{
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "command": "npx",
        "args": [
          "-y",
          "chrome-devtools-mcp@latest",
          "--browserUrl",
          "ws://localhost:9222/devtools/browser"
        ]
      },
      "chrome-devtools-edge": {
        "command": "npx",
        "args": [
          "-y",
          "chrome-devtools-mcp@latest",
          "--browserUrl",
          "ws://localhost:9223/devtools/browser"
        ]
      }
    }
  },
  "agentMemory.autoSyncToFile": ".github/copilot/memory.instructions.md"
}