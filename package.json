{
  "name": "at-your-service",
  "version": "1.2.3",
  "description": "WordPress plugin for service-based businesses",
  "main": "index.js",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint": "npm run lint:php && npm run lint:js",
    "lint:php": "phpcs --standard=WordPress .",
    "lint:js": "eslint assets/js public/js admin/js --ext .js",
    "format": "npm run format:php && npm run format:js",
    "format:php": "phpcbf --standard=WordPress .",
    "format:js": "prettier --write 'assets/**/*.js' 'public/**/*.js' 'admin/**/*.js'",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "service-business",
    "crm",
    "invoicing"
  ],
  "author": "Shaun Palmer",
  "license": "GPL-2.0+",
  "devDependencies": {
    "@wordpress/scripts": "^27.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "jquery": "^3.6.0"
  }
}